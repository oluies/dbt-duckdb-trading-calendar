//| mill-version: 1.3.1
package build

import mill.*, scalalib.*, scalajslib.*, scalajslib.api.*

// Interactive SEK/EUR regime chart: Scala.js + Laminar over TradingView
// Lightweight Charts (loaded from unpkg by index.html, used through the
// facade in LightweightCharts.scala). `./mill app.fullLinkJS` links
// out/app/fullLinkJS.dest/main.js; `make` in this directory assembles
// the deployable site in dist/.
object app extends ScalaJSModule {
  def scalaVersion = "3.3.7"
  def scalaJSVersion = "1.22.0"
  def moduleKind = ModuleKind.NoModule
  def mvnDeps = Seq(mvn"com.raquo::laminar::17.2.1")
}
